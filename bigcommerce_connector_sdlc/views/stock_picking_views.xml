<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_bigcommerce" model="ir.ui.view">
        <field name="name">stock.picking.form.bigcommerce</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="BigCommerce" name="bigcommerce"
                      invisible="not bigcommerce_shipment_id and not bigcommerce_shipment_error">
                    <group>
                        <group>
                            <field name="bigcommerce_shipment_id"/>
                            <field name="bigcommerce_shipment_exported_at"/>
                        </group>
                        <group>
                            <field name="bigcommerce_shipment_error"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
