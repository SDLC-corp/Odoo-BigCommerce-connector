<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bigcommerce_order_binding_list" model="ir.ui.view">
            <field name="name">bigcommerce.order.binding.list</field>
            <field name="model">bigcommerce.order.binding</field>
            <field name="arch" type="xml">
                <list string="Order Bindings" decoration-danger="sync_state == 'error'"
                      decoration-warning="needs_attention and sync_state != 'error'">
                    <header>
                        <button name="action_resync_from_bigcommerce" string="Re-sync from BigCommerce" type="object"
                                groups="bigcommerce_connector_sdlc.group_bigcommerce_manager"/>
                    </header>
                    <field name="instance_id"/>
                    <field name="bigcommerce_order_number"/>
                    <field name="sale_order_id"/>
                    <field name="customer_name" string="Customer Name"/>
                    <field name="customer_email" string="Customer Email"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="sale_order_amount_total" string="Odoo Total" optional="hide"/>
                    <field name="bigcommerce_total_display" string="Total"/>
                    <field name="status_on_bigcommerce"/>
                    <field name="sale_order_state" string="Odoo Status"/>
                    <field name="sync_state"/>
                    <field name="sale_order_date" string="Order Date"/>
                    <field name="imported_at"/>
                    <field name="exported_at" optional="hide"/>
                    <field name="needs_attention" column_invisible="1"/>
                    <field name="exception_reason" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_bigcommerce_order_binding_form" model="ir.ui.view">
            <field name="name">bigcommerce.order.binding.form</field>
            <field name="model">bigcommerce.order.binding</field>
            <field name="arch" type="xml">
                <form string="Order Binding">
                    <header>
                        <button name="action_resync_from_bigcommerce" string="Re-sync from BigCommerce" type="object"
                                class="oe_highlight" groups="bigcommerce_connector_sdlc.group_bigcommerce_manager"/>
                    </header>
                    <sheet>
                        <div class="alert alert-warning" role="alert" invisible="not needs_attention">
                            <strong>Needs attention:</strong> <field name="exception_reason" readonly="1" class="d-inline"/>
                        </div>
                        <group>
                            <group>
                                <field name="instance_id"/>
                                <field name="sale_order_id"/>
                                <field name="sync_state"/>
                                <field name="status_on_bigcommerce"/>
                            </group>
                            <group>
                                <field name="bigcommerce_order_id"/>
                                <field name="bigcommerce_order_number"/>
                                <field name="imported_at" readonly="1"/>
                                <field name="exported_at" readonly="1"/>
                            </group>
                        </group>
                        <group string="Reconciliation">
                            <group>
                                <field name="bigcommerce_total_display" string="BigCommerce Total"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="sale_order_amount_total"/>
                            </group>
                            <group>
                                <field name="amount_mismatch"/>
                                <field name="currency_mismatch"/>
                                <field name="has_placeholder_lines"/>
                                <field name="needs_attention" invisible="1"/>
                            </group>
                        </group>
                        <group string="Error">
                            <field name="last_error" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_bigcommerce_order_binding_search" model="ir.ui.view">
            <field name="name">bigcommerce.order.binding.search</field>
            <field name="model">bigcommerce.order.binding</field>
            <field name="arch" type="xml">
                <search string="Order Bindings">
                    <field name="instance_id"/>
                    <field name="sync_state"/>
                    <field name="sale_order_id"/>
                    <field name="bigcommerce_order_id"/>
                    <field name="bigcommerce_order_number"/>
                    <field name="customer_name"/>
                    <field name="customer_email"/>
                    <field name="status_on_bigcommerce"/>
                    <field name="sale_order_state"/>
                    <filter name="filter_state_draft" string="Draft" domain="[('sync_state', '=', 'draft')]"/>
                    <filter name="filter_state_synced" string="Synced" domain="[('sync_state', '=', 'synced')]"/>
                    <filter name="filter_state_error" string="Error" domain="[('sync_state', '=', 'error')]"/>
                    <filter name="filter_missing_sale_order" string="Missing Sale Order" domain="[('sale_order_id', '=', False)]"/>
                    <separator/>
                    <filter name="filter_needs_attention" string="Needs Attention" domain="[('needs_attention', '=', True)]"/>
                    <filter name="filter_amount_mismatch" string="Total Mismatch" domain="[('amount_mismatch', '=', True)]"/>
                    <filter name="filter_placeholder" string="Unmatched Products" domain="[('has_placeholder_lines', '=', True)]"/>
                    <separator/>
                    <group>
                        <filter name="group_by_instance" string="Instance" context="{'group_by': 'instance_id'}"/>
                        <filter name="group_by_state" string="Sync State" context="{'group_by': 'sync_state'}"/>
                        <filter name="group_by_status" string="BC Status" context="{'group_by': 'status_on_bigcommerce'}"/>
                        <filter name="group_by_sale_state" string="Odoo Status" context="{'group_by': 'sale_order_state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_bigcommerce_order_binding" model="ir.actions.act_window">
            <field name="name">Order Bindings</field>
            <field name="res_model">bigcommerce.order.binding</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_bigcommerce_order_binding_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No BigCommerce orders imported yet.</p>
                <p>Run <b>Sync Orders</b> on a connector, or enable automatic order import. Only orders modified after the connector's checkpoint are read, oldest first.</p>
            </field>
        </record>

        <record id="action_bigcommerce_order_exceptions" model="ir.actions.act_window">
            <field name="name">Order Exceptions</field>
            <field name="res_model">bigcommerce.order.binding</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_bigcommerce_order_binding_search"/>
            <field name="context">{'search_default_filter_needs_attention': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No order needs attention.</p>
                <p>
                    Orders land here when their import or shipment export failed, when the Odoo total differs from
                    the BigCommerce total by more than the connector tolerance, when BigCommerce charged in another
                    currency, or when a line could not be matched to an Odoo product. Fix the cause, then use
                    <b>Re-sync from BigCommerce</b>.
                </p>
            </field>
        </record>

    </data>
</odoo>
