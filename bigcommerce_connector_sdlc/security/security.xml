<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Three roles (each implies the previous one):
        * User          - reads connectors (without credentials), bindings, logs and the dashboard.
        * Manager       - runs syncs, retries webhook events, re-syncs orders, triages exceptions.
        * Administrator - creates/configures connectors, sees and edits credentials, manages
                          webhooks and field mappings. Settings administrators get it implicitly.
    -->
    <record id="module_category_bigcommerce" model="ir.module.category">
        <field name="name">BigCommerce</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_bigcommerce" model="res.groups.privilege">
        <field name="name">BigCommerce</field>
        <field name="category_id" ref="bigcommerce_connector_sdlc.module_category_bigcommerce"/>
    </record>

    <record id="group_bigcommerce_user" model="res.groups">
        <field name="name">BigCommerce User (Read Only)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="bigcommerce_connector_sdlc.res_groups_privilege_bigcommerce"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bigcommerce_manager" model="res.groups">
        <field name="name">BigCommerce Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="bigcommerce_connector_sdlc.res_groups_privilege_bigcommerce"/>
        <field name="implied_ids" eval="[(4, ref('bigcommerce_connector_sdlc.group_bigcommerce_user'))]"/>
    </record>

    <record id="group_bigcommerce_admin" model="res.groups">
        <field name="name">BigCommerce Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="bigcommerce_connector_sdlc.res_groups_privilege_bigcommerce"/>
        <field name="implied_ids" eval="[(4, ref('bigcommerce_connector_sdlc.group_bigcommerce_manager'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('bigcommerce_connector_sdlc.group_bigcommerce_admin'))]"/>
    </record>

    <!-- Multi-company isolation: group-less (restriction) entries in security/ir.access.csv,
         Odoo 20 replacement of the former global ir.rule records; they also bind administrators. -->
</odoo>
